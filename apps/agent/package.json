{
  "name": "@termix/agent",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Termix device agent - runs on the target machine",
  "main": "dist/index.js",
  "bin": {
    "termix-agent": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "socket.io-client": "^4.7.0",
    "node-pty": "^1.0.0",
    "systeminformation": "^5.22.0",
    "dotenv": "^16.4.0",
    "uuid": "^9.0.0",
    "@termix/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "tsx": "^4.7.0",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.7"
  }
}
